<UserControl
    x:Class="SmartAdder.Views.SmartAdderControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:SmartAdder.Models">

    <Grid Padding="24" MaxWidth="400" HorizontalAlignment="Left">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Sum Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Total Sum" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            <TextBlock Text="{x:Bind ViewModel.TotalSum, Mode=OneWay}" FontSize="42" FontWeight="SemiBold"/>
        </StackPanel>

        <!-- Dynamic Cell List -->
        <ListView Grid.Row="1" 
                  ItemsSource="{x:Bind ViewModel.Cells}" 
                  SelectionMode="None"
                  ShowsScrollingPlaceholders="False">

            <!-- Remove standard ListView styling/padding for a cleaner "Excel" look -->
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="MinHeight" Value="40"/>
                    <Setter Property="Padding" Value="0,0,0,8"/>
                </Style>
            </ListView.ItemContainerStyle>

            <ListView.ItemTemplate>
                <DataTemplate x:DataType="models:NumberCell">
                    <!-- UpdateSourceTrigger=PropertyChanged ensures the VM updates on every keystroke -->
                    <TextBox Text="{x:Bind InputValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             PlaceholderText="Enter number"
                             InputScope="Number"
                             Width="200"
                             HorizontalAlignment="Left"/>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</UserControl>