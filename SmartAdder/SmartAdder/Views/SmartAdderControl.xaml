<UserControl
    x:Class="SmartAdder.Views.SmartAdderControl"
    x:Name="RootControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:SmartAdder.Models"
    xmlns:interactivity="using:Microsoft.Xaml.Interactivity"
    xmlns:behaviors="using:SmartAdder.Behaviors">

    <Grid x:Name="RootGrid" Padding="24" MaxWidth="400" HorizontalAlignment="Left" VerticalAlignment="Top" Background="Transparent">
        <interactivity:Interaction.Behaviors>
            <behaviors:HoverBehavior IsHovering="{x:Bind ViewModel.IsHovering, Mode=TwoWay}" />
        </interactivity:Interaction.Behaviors>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Sum Header -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal">
                <TextBlock Text="{x:Bind ViewModel.TotalSum, Mode=OneWay}" FontSize="24" FontWeight="SemiBold" VerticalAlignment="Center"/>

                <!--next two buttons after the textblock-->
                <Button Grid.Column="1" Command="{x:Bind ViewModel.ClearAllCommand}" ToolTipService.ToolTip="Clear all" Width="32" Height="32" Padding="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" VerticalAlignment="Center" Margin="8,0,0,0">
                    <SymbolIcon Symbol="Clear" />
                </Button>

                <Button Grid.Column="2" Command="{x:Bind ViewModel.ViewHistoryCommand}" ToolTipService.ToolTip="View history" Width="32" Height="32" Padding="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" VerticalAlignment="Center" Margin="4,0,0,0">
                    <SymbolIcon Symbol="Clock" />
                </Button>
            </StackPanel>
        </Grid>

        <!-- Dynamic Cell List -->
        <ListView x:Name="CellListView"
                  Grid.Row="1"
                  ItemsSource="{x:Bind ViewModel.Cells}" 
                  SelectionMode="None"
                  ShowsScrollingPlaceholders="False"
                  Visibility="{x:Bind ViewModel.ListVisibility, Mode=OneWay}">
            <interactivity:Interaction.Behaviors>
                <behaviors:FocusWithinBehavior IsFocused="{x:Bind ViewModel.IsListFocused, Mode=TwoWay}" />
            </interactivity:Interaction.Behaviors>

            <!-- Remove standard ListView styling/padding for a cleaner "Excel" look -->
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="MinHeight" Value="40"/>
                    <Setter Property="Padding" Value="0,0,0,8"/>
                </Style>
            </ListView.ItemContainerStyle>

            <ListView.ItemTemplate>
                <DataTemplate x:DataType="models:NumberCell">
                    <!-- UpdateSourceTrigger=PropertyChanged ensures the VM updates on every keystroke -->
                    <TextBox Text="{x:Bind InputValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             PlaceholderText="Enter number"
                             InputScope="Number"
                             Width="80"
                             HorizontalAlignment="Left">
                        <interactivity:Interaction.Behaviors>
                            <behaviors:NumericTextBoxBehavior DeleteCommand="{Binding ElementName=RootControl, Path=ViewModel.DeleteCellCommand}" />
                        </interactivity:Interaction.Behaviors>
                    </TextBox>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</UserControl>
